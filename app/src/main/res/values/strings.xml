    <!-- Fitur: Browser + Website Blocking (Fase 1) -->
    <string name="label_website_blocking">Website yang Diblokir</string>
    <string name="website_blocking_hint">Hanya Google Chrome yang diizinkan sebagai browser — browser lain (Firefox, Samsung Internet, Edge, dst.) otomatis ditutup. Domain di bawah ini, DITAMBAH sejumlah domain dewasa bawaan, akan diblokir kalau dibuka lewat Chrome. Ini murni pencocokan teks address bar secara lokal di perangkat — lihat catatan keterbatasan di README.</string>
    <string name="btn_add_domain">+ Tambah Domain</string>
    <string name="empty_domains">Belum ada domain custom (domain dewasa bawaan tetap aktif)</string>
    <string name="dialog_add_domain_title">Tambah Domain</string>
    <string name="dialog_add_domain_hint">Masukkan domain yang mau diblokir (contoh: example.com). Subdomain-nya ikut terblokir otomatis.</string>
    <string name="hint_domain_name">Domain, contoh: example.com</string>
    <string name="toast_invalid_domain">Domain tidak valid atau sudah ada di daftar</string>

    <!-- Fitur: Content Detection (Fase 2) -->
    <string name="label_content_detection">Deteksi Konten</string>
    <string name="content_detection_hint">Mendeteksi teks vulgar/NSFW di halaman Chrome dan pesan Telegram (berbasis kata kunci + threshold, murni lokal di perangkat). Deteksi GAMBAR (tanpa teks) belum aktif — butuh model AI terlatih yang belum terpasang.</string>
    <string name="switch_content_detection">Aktifkan Content Detection</string>
    <string name="btn_view_log">Lihat Log Deteksi</string>
    <string name="dialog_log_title">Log Deteksi Konten</string>
    <string name="dialog_log_empty">Belum ada deteksi tercatat.</string>
    <string name="btn_clear_log">Hapus Log</string>

    <!-- Fitur: Deteksi Gambar AI (Fase 2b) -->
    <string name="label_image_detection">Deteksi Gambar (AI)</string>
    <string name="image_detection_hint">Screenshot berkala (bukan real-time per-frame) dianalisis model AI on-device untuk skor risiko konten. DEFAULT NONAKTIF. Kalau belum ada model TFLite terpasang di assets, toggle ini boleh dinyalakan tapi TIDAK akan berbuat apa-apa (status di bawah akan bilang "model belum terpasang").</string>
    <string name="switch_image_detection">Aktifkan Deteksi Gambar (AI)</string>
    <string name="image_detection_status_available">Model terpasang, deteksi gambar aktif</string>
    <string name="image_detection_status_unavailable">Model belum terpasang — toggle ini belum berefek</string>
    <string name="image_detection_status_unsupported">Perangkat ini di bawah Android 11 — fitur ini tidak didukung</string>

