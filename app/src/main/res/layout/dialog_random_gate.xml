<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/random_gate_title"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvGateProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="1 / 512" />

    <TextView
        android:id="@+id/tvRandomText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F0F0"
        android:padding="20dp"
        android:gravity="center"
        android:textIsSelectable="false"
        android:longClickable="false"
        android:fontFamily="monospace"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="F" />

    <TextView
        android:id="@+id/tvGateError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/random_gate_wrong"
        android:textColor="@color/danger"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/random_gate_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRandomTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textVisiblePassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="20sp"
            android:longClickable="false"
            android:textIsSelectable="false" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
